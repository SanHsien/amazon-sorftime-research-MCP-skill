# ========================================================
# Amazon Sorftime Research MCP Credentials Template
# 請複製此檔案為 .env 並填入您的正式金鑰。切勿將 .env 提交至版本庫。
# ========================================================

# 1. Sorftime MCP API 金鑰 (https://sorftime.com/zh-cn/mcp)
SORFTIME_API_KEY=your_sorftime_api_key_here

# 2. Sif MCP Secret Key (https://mcp.sif.com)
SIF_SECRET_KEY=your_sif_secret_key_here

# 3. 西柚洞察 MCP 授權憑證 (https://mcp.xydc.com)
XIYOU_AUTH_TOKEN=your_xiyou_bearer_token_here

# 4. 賣家精靈 SellerSprite MCP Secret Key (https://mcp.sellersprite.com)
SELLERSPRITE_SECRET_KEY=your_sellersprite_secret_key_here

